DATABASE_URL="postgresql://app_user:app_segura@localhost:5432/incidentes_ic?schema=public"
JWT_SECRET="REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
PORT=3000
# Producción: NODE_ENV="production" y FRONTEND_URL con el origen HTTPS exacto del frontend.
# Detrás de un proxy (Render, Railway, etc.): número de proxies de confianza, normalmente 1.
# TRUST_PROXY=1
# Frontend y API en dominios distintos: none (requiere HTTPS). Mismo dominio: strict (por defecto).
# COOKIE_SAMESITE=strict
# Opcionales: caché del estado de usuario (ms, 0 = desactivada, máx. 60000) y costo de bcrypt (10-14)
USER_STATUS_CACHE_TTL_MS=5000
BCRYPT_COST=12
